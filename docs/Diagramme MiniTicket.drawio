        <mxCell id="FXILqfok5hL-R_3xlYMs-5" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;color: rgb(74, 69, 62); font-family: &amp;quot;IBM Plex Mono&amp;quot;, monospace; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(250, 248, 245); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: flex; align-items: center; gap: 12px;&quot;&gt;tout compte authentifié&lt;/div&gt;&lt;div style=&quot;color: rgb(74, 69, 62); font-family: &amp;quot;IBM Plex Mono&amp;quot;, monospace; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(250, 248, 245); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: flex; align-items: center; gap: 12px;&quot;&gt;&lt;/div&gt;&lt;br class=&quot;Apple-interchange-newline&quot;&gt;" vertex="1">
